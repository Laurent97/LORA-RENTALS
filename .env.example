# Supabase (auth, Postgres, realtime, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (vehicle & KYC image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Mapbox (pickup location maps)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=https://lorarentals.org

# Postmark (transactional email) — SERVER ONLY, never expose to the client
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=noreply@lorarentals.org
POSTMARK_FROM_NAME=LORA RENTALS
POSTMARK_REPLY_TO=support@lorarentals.org
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast
# Shared secret Postmark must send as ?token= on https://lorarentals.org/api/email/webhook
POSTMARK_WEBHOOK_SECRET=
# Shared secret for server-to-server calls to /api/email/send (x-email-secret header)
EMAIL_API_SECRET=
# Optional CDN for email images; defaults to NEXT_PUBLIC_SITE_URL/email
EMAIL_ASSET_BASE=
